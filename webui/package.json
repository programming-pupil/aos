    "antd": "^5.22.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.0",
    "fastest-levenshtein": "^1.0.16",
    "fflate": "^0.8.3",
    "i18next": "^26.0.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-markdown": "^10.1.0",
