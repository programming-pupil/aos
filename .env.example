# AOS example environment.
# Generate a unique local .env before running Docker Compose:
#   ./scripts/generate-env.sh
#   docker compose up --build

# -----------------------------------------------------------------------------
# Public URLs / ports
# -----------------------------------------------------------------------------
AOS_WEB_PORT=3000
AOS_API_PORT=3001
AOS_BIND_HOST=127.0.0.1
BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API directly. Leave empty
# to allow only BASE_URL. Use * only for an isolated development environment.
CORS_ALLOWED_ORIGINS=
# Self-hosted deployments are invite-only by default after first-boot setup.
AOS_ALLOW_PUBLIC_REGISTRATION=false

# -----------------------------------------------------------------------------
# Local platform database
# AOS creates /data/aos.db automatically. Keep the data directory on a local
# filesystem and run only one AOS server process against it.
# -----------------------------------------------------------------------------
AOS_SQLITE_MAX_CONNECTIONS=8
AOS_SQLITE_CONTROL_MAX_CONNECTIONS=8
AOS_SQLITE_BUSY_TIMEOUT_MS=30000
AOS_SQLITE_ACQUIRE_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Required server secrets
# JWT_SECRET can be any strong random string.
# ENCRYPTION_KEY must be exactly 32 bytes because API keys are AES-256-GCM encrypted.
# TOKEN_ENCRYPTION_KEY is used by the current Git project token store.
# -----------------------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Default model fallback
# Most runtime calls should be configured from System -> API Keys after setup.
# DEFAULT_MODEL is only a fallback when no table-backed model is selected.
# -----------------------------------------------------------------------------
DEFAULT_MODEL=anthropic/claude-opus-4-8

# Optional env fallback keys. Prefer configuring keys in the Web UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tenant runtimes fail closed by default and do not borrow process-wide model
# or embedding credentials. Enable these only for isolated development.
AOS_ALLOW_TENANT_MODEL_ENV_FALLBACK=false
AOS_ALLOW_TENANT_EMBEDDING_ENV_FALLBACK=false

# Secret redaction is always enabled at model, tool, Hook, Bot and persistence
# boundaries. Enable strict mode to also redact email, phone and payment-card
# values. Production tenants should validate this against their data policy.
AOS_DATA_PROTECTION_STRICT_PII=false

# Optional GitHub token for Skill marketplace scans/installs.
# Anonymous GitHub API requests are heavily rate-limited per public IP.
AOSD_GITHUB_TOKEN=

# Optional embedding settings for NL2SQL semantic routing.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=

# AOS built-in web search needs internet access but no search API key. Search
# Extensions configured in WebUI are optional enhancements. Override these
# upstream URLs only for a compatible mirror or controlled test environment.
AOSD_BUILTIN_SEARCH_DDG_URL=https://html.duckduckgo.com/html/
AOSD_BUILTIN_SEARCH_BRAVE_URL=https://search.brave.com/search
AOSD_BUILTIN_SEARCH_BING_URL=https://www.bing.com/search
AOSD_BUILTIN_SEARCH_HN_URL=https://hn.algolia.com/api/v1/search
AOSD_BUILTIN_SEARCH_STACK_EXCHANGE_URL=https://api.stackexchange.com/2.3/search/advanced
# Optional: point all Wikipedia requests to a compatible MediaWiki API mirror.
AOSD_BUILTIN_SEARCH_WIKIPEDIA_URL=
# Open-Meteo provides zero-key geocoding and structured current/7-day weather.
AOSD_BUILTIN_WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
AOSD_BUILTIN_WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Per-source deadline and the short collection window after the first success.
AOSD_BUILTIN_SEARCH_SOURCE_TIMEOUT_SECS=8
AOSD_BUILTIN_SEARCH_MULTI_SOURCE_GRACE_MS=1200

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_IMAGE_BYTES=1048576

# -----------------------------------------------------------------------------
# Bot Gateway / background jobs
# -----------------------------------------------------------------------------
BOT_GATEWAY_INBOUND_POLL_SECS=10
PM_SCHEDULER_INTERVAL_SECS=120
PM_RESEARCH_TASK_RUNTIME_POLL_SECS=5
# Fairness limits apply inside the single AOS server process.
PM_RESEARCH_TASK_MAX_CONCURRENT=4
PM_RESEARCH_TASK_MAX_CONCURRENT_PER_TENANT=2

# High-volume PM progress, answer recovery, and tool ledgers use a bounded
# write-behind queue. Final answers, cancellation, leases, and task snapshots
# are always persisted synchronously through the control lane.
PM_TELEMETRY_QUEUE_CAPACITY=2048
PM_TELEMETRY_BATCH_SIZE=128
PM_TELEMETRY_FLUSH_MS=500
PM_TELEMETRY_WAL_MODE=durable
PM_TELEMETRY_WAL_QUEUE_CAPACITY=512
PM_TELEMETRY_WAL_MAX_BYTES=268435456
PM_TELEMETRY_WAL_MAX_SEGMENTS=4096
PM_TELEMETRY_WAL_REPLAY_BATCH_SEGMENTS=32
PM_TELEMETRY_RAW_RETENTION_DAYS=7
PM_TELEMETRY_EVENT_RETENTION_DAYS=30
PM_TELEMETRY_RETENTION_BATCH_SIZE=500

# Bound all background control-plane workers independently of the SQLite pool.
WATCHDOG_DB_MAX_CONCURRENT=3
AOS_BOT_QUEUE_MAX_CONCURRENT=8
AOS_BOT_QUEUE_MAX_CONCURRENT_PER_TENANT=2
AOS_BOT_QUEUE_BATCH_SIZE=5
TASK_CONTROL_SSE_RECOVERY_POLL_MS=15000
# Only catch up scheduled missions missed within this window after downtime.
PM_MISSION_MISFIRE_GRACE_SECS=300

# Task notifications use the durable outbox and are delivered to WebUI plus
# explicitly bound Bot conversations. Set to shadow to retain events without
# external delivery. Stale must remain greater than stalled.
WATCHDOG_NOTIFICATION_OUTBOX_MODE=on
WATCHDOG_STALLED_AFTER_SECONDS=600
WATCHDOG_STALE_AFTER_SECONDS=1800

# -----------------------------------------------------------------------------
# Code Studio / Engineering runtime
# Keep runtime-first for Claude Code-style repository understanding. Direct
# fallback is off by default so Code tasks do not silently degrade to plain chat.
# -----------------------------------------------------------------------------
AOS_RD_RUNTIME_EXECUTOR=runtime
AOS_RD_RUNTIME_TIMEOUT_SECS=1800
AOS_RD_TEST_COMMAND_TIMEOUT_SECS=180
AOS_RD_AUTO_REPAIR_MAX_ATTEMPTS=3
AOS_RD_RUNTIME_DIRECT_FALLBACK=false
AOS_RD_ARCHITECTURE_PASS_ENABLED=true
AOS_RD_REVIEWER_PASS_ENABLED=true

# -----------------------------------------------------------------------------
# Optional SMTP invite email settings. Leave blank to disable email sending.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="AOS <noreply@example.com>"

# Logging
RUST_LOG=web_server=info,agent_gateway=info,runtime=info,tower_http=info,billing=info
